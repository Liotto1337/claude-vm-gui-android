{
  "name": "claude-vm-android",
  "version": "0.2.2",
  "description": "Android-клиент для Claude Code на ВМ: SSH, tmux и интерфейс в стиле claude.ai",
  "author": "Liotto1337 <egorstep.0801@gmail.com>",
  "license": "MIT",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:e2e": "vite build && playwright test",
    "bridge": "tsx --tsconfig tsconfig.node.json bridge/server.ts",
    "android:web": "vite build --mode android && node scripts/check-no-devbridge.mjs dist",
    "android:build": "npm run android:web && bash -c '. scripts/android-env.sh && npx cap sync android && cd android && ./gradlew -q assembleDebug'",
    "android:run": "npm run android:web && bash -c '. scripts/android-env.sh && npx cap run android'",
    "test:android": "bash -c '. scripts/android-env.sh && cd android && ./gradlew -q testDebugUnitTest'"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/clipboard": "8.0.1",
    "@capacitor/core": "8.5.3",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/status-bar": "8.0.4",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/source-serif-4": "5.3.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.3",
    "@playwright/test": "1.64.1",
    "@types/node": "22.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "@types/ssh2": "1.15.6",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "ssh2": "1.17.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "ws": "8.22.0"
  }
}
