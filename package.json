{
  "name": "claude-vm-android",
  "version": "0.2.2",
  "description": "Android-клиент для Claude Code на ВМ: SSH, tmux и интерфейс в стиле claude.ai",
  "author": "Liotto1337 <egorstep.0801@gmail.com>",
  "license": "MIT",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:e2e": "vite build && playwright test"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/source-serif-4": "5.3.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "@types/ssh2": "1.15.6",
    "@vitejs/plugin-react": "6.1.2",
    "ssh2": "1.17.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
