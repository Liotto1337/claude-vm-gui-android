{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": [
        "src/shared/*"
      ],
      "@core/*": [
        "src/core/*"
      ]
    }
  },
  "include": [
    "src/shared/**/*",
    "tests/**/*",
    "scripts/**/*",
    "*.config.ts",
    "*.config.mts",
    "src/core/**/*",
    "vite.config.ts",
    "bridge/**/*",
    "src/platform/bridge-protocol.ts"
  ],
  "exclude": [
    "src/main/controller.ts"
  ]
}
