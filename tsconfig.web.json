{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": [
        "src/shared/*"
      ],
      "@core/*": [
        "src/core/*"
      ]
    },
    "types": [
      "vite/client"
    ]
  },
  "include": [
    "src/core/**/*",
    "src/platform/**/*",
    "src/renderer/**/*",
    "src/shared/**/*"
  ],
  "exclude": [
    "src/shared/known-hosts.ts"
  ]
}
